# Copy to .env and fill in. Never commit real keys.
#   cp .env.example .env

# Planet: https://www.planet.com/account/#/user-settings
# Legacy API keys still work. `planet auth login` also works if you leave this empty.
# Nick may need a new Planet key for this personal fork.
PLANET_API_KEY=

# Sentinel-2 via Planetary Computer STAC (`cssic gather -s stac`) needs no key.

# Sentinel imagery: Copernicus Data Space Process API (`cssic gather -s s`).
# Create an OAuth client at:
#   https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings
# Copy the client secret immediately; it is shown only once.
# Old Sentinel Hub instance IDs from apps.sentinel-hub.com will not work.
SH_CLIENT_ID=
SH_CLIENT_SECRET=
SENTINEL_PROVIDER=cdse

# Optional: commercial Sentinel Hub instead of CDSE
# SENTINEL_PROVIDER=sentinelhub
