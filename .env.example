# Copy to .env and fill in what you need. Never commit real keys.
#   cp .env.example .env
#
# Nothing here is required for the default path: `cssic extract` (ohsome) and
# `cssic gather -s stac` (Planetary Computer Sentinel-2) use open APIs.

# --- Planet: `cssic gather -s p` ------------------------------------------
# https://www.planet.com/account/#/user-settings
# Legacy API keys still work. Leave this empty to use `planet auth login`
# instead (the SDK's own PL_API_KEY / ~/.planet.json session is also read).
PLANET_API_KEY=

# --- Sentinel-2 Process API: `cssic gather -s s` --------------------------
# Create an OAuth client (not a configuration "instance id") at:
#   https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings
# The client secret is shown only once - copy it immediately.
# Old Sentinel Hub instance ids from apps.sentinel-hub.com will not work.
SH_CLIENT_ID=
SH_CLIENT_SECRET=

# cdse (default, free Copernicus Data Space) or sentinelhub (commercial).
# The two are not interchangeable: an OAuth client works with one, not both.
SENTINEL_PROVIDER=cdse
